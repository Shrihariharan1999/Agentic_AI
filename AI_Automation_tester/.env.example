APP_NAME=AI Web Tester
APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=nvidia

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

DISCOVERY_PROVIDER=nvidia
DISCOVERY_MODEL=meta/llama-3.3-70b-instruct

PLANNER_PROVIDER=nvidia
PLANNER_MODEL=meta/llama-3.3-70b-instruct

TEST_WRITER_PROVIDER=nvidia
TEST_WRITER_MODEL=meta/llama-3.3-70b-instruct

EXECUTOR_PROVIDER=nvidia
EXECUTOR_MODEL=meta/llama-3.3-70b-instruct

FAILURE_ANALYZER_PROVIDER=nvidia
FAILURE_ANALYZER_MODEL=meta/llama-3.3-70b-instruct

SUMMARY_PROVIDER=nvidia
SUMMARY_MODEL=meta/llama-3.3-70b-instruct

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-web-tester
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_web_tester
MYSQL_USER=root
MYSQL_PASSWORD=

RAG_INDEX_PATH=data/vector_store

MAX_TEST_CASES=50
MAX_EXECUTION_RETRIES=2
MAX_HEALING_ATTEMPTS=2

ALLOWED_TARGET_DOMAINS=

MCP_BROWSER_ENABLED=true
MCP_BROWSER_TRANSPORT=stdio
MCP_BROWSER_URL=
MCP_BROWSER_COMMAND=npx
MCP_BROWSER_ARGS=@playwright/mcp@latest