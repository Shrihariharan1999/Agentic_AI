# Required for the Coordinator, Analyst, Validator, and browser verifier.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Required for primary web research.
SERPER_API_KEY=YOUR_SERPER_API_KEY

# Used as the web-research fallback.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=autonomous-data-analyst

# Maximum number of tool calls allowed for one user request.
MAX_TOOL_CALLS_PER_TURN=8